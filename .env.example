# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file (it's already in .gitignore).

# --- CognoDB Cloud ---
COGNODB_URI=bolt+s://db-17dd4156.bravo.databases.cognodb.com:7687
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# --- Neo4j AuraDB Free ---
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Memgraph (self-hosted via docker-compose, resource-capped) ---
MEMGRAPH_URI=bolt://localhost:7688
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# --- FalkorDB (self-hosted via docker-compose) ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=benchmark

# --- ArangoDB (self-hosted via docker-compose) ---
ARANGO_URL=http://localhost:8529
ARANGO_DB=benchmark
ARANGO_USER=root
ARANGO_PASSWORD=

# --- Benchmark tuning ---
BENCH_ITERATIONS=100
BENCH_WARMUP=20
BENCH_CONCURRENCY=10
